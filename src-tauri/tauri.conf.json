{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netbox",
  "version": "0.1.0-alpha.1",
  "identifier": "local.netbox.network-toolkit.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "netbox · 网络工具箱", "width": 1220, "height": 820, "minWidth": 960, "minHeight": 680}],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": false }
}
